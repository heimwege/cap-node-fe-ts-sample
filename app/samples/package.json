{
  "name": "samples",
  "version": "1.0.0",
  "description": "A Sample Application for CAP (Node) Fiori Elements and TypeScript",
  "scripts": {
    "build:cds": "npm --prefix ../../ run build:cds && npm run odata:types:generate",
    "build:sample": "npm run ts:typecheck && npm run ui5lint && ui5 build --config=./ui5-build.yaml --clean-dest --dest ./dist",
    "build:ts:mockserver": "babel ./webapp/localService/mockdata --out-dir ./webapp/localService/mockdata --extensions \".ts\" --copy-files",
    "e2e:test": "start-server-and-test ui:test:server http://localhost:8080/ wdio:run",
    "e2e:test:debug": "start-server-and-test ui:test:server http://localhost:8080/ wdio:run:debug",
    "e2e:test:headless": "start-server-and-test ui:test:server http://localhost:8080/ wdio:run:headless",
    "eslint": "eslint ./webapp/**/*.ts -f eslint-formatter-multiple",
    "lint": "npm run eslint && npm run ui5lint",
    "odata:types:generate": "odata2ts",
    "sort:package-json": "npx --yes sort-package-json",
    "ts:typecheck": "tsc --noEmit",
    "ui:cap": "ui5 serve -o localService/index.html#Samples-display --config ./ui5-with-cap.yaml",
    "ui:mockserver": "ui5 serve -o localService/index.html#Samples-display --config ./ui5-local.yaml",
    "ui:mockserver:proxy": "ui5 serve -o localService/index.html#Samples-display",
    "ui:mockserver:proxy:rta": "ui5 serve -o localService/variantsManagement.html#Samples-display",
    "ui:opa5": "ui5 serve -o test/opaTests.qunit.html --config ./ui5-local.yaml",
    "ui:qunit": "ui5 serve -o test/unitTests.qunit.html --config ./ui5-local.yaml",
    "ui:test": "ui5-test-runner",
    "ui5lint": "npx --yes @ui5/linter@latest --fix",
    "wdio:run": "wdio run webapp/test/wdi5/wdio-ui5.conf.ts",
    "wdio:run:debug": "wdio run webapp/test/wdi5/wdio-ui5.conf.ts -- --debug",
    "wdio:run:headless": "wdio run webapp/test/wdi5/wdio-ui5.conf.ts -- --headless"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-typescript": "7.28.5",
    "@istanbuljs/nyc-config-babel": "3.0.0",
    "@odata2ts/odata2ts": "0.40.1",
    "@sap-ux/eslint-plugin-fiori-tools": "^9.7.5",
    "@sap-ux/preview-middleware": "0.23.150",
    "@sap-ux/ui5-middleware-fe-mockserver": "2.4.10",
    "@sap/ux-ui5-tooling": "1.20.4",
    "@sapui5/types": "1.144.1",
    "@types/qunit": "2.5.4",
    "@types/sinon": "2.3.0",
    "@ui5/cli": "4.0.47",
    "@wdio/cli": "9.24.0",
    "@wdio/junit-reporter": "9.24.0",
    "@wdio/local-runner": "9.24.0",
    "@wdio/mocha-framework": "9.24.0",
    "@wdio/spec-reporter": "9.24.0",
    "@wdio/types": "9.24.0",
    "babel-plugin-istanbul": "7.0.1",
    "babel-preset-transform-ui5": "7.8.1",
    "cap-fe-ts-sample-node": "file:../..",
    "eslint": "9.39.2",
    "eslint-formatter-checkstyle": "9.0.1",
    "eslint-formatter-multiple": "2.0.0",
    "nyc": "17.1.0",
    "prettier": "3.8.1",
    "puppeteer": "24.38.0",
    "selenium-webdriver": "4.41.0",
    "typescript": "5.9.3",
    "ui5-middleware-cap": "3.3.4",
    "ui5-middleware-livereload": "3.2.1",
    "ui5-task-check-eocp": "0.0.8",
    "ui5-task-zipper": "3.5.1",
    "ui5-test-runner": "5.13.0",
    "ui5-tooling-transpile": "3.10.1",
    "wdio-json-html-reporter": "1.5.14",
    "wdio-ui5-service": "3.0.8"
  },
  "engines": {
    "node": "^20.11.0"
  },
  "eslint-formatter-multiple": {
    "formatters": [
      {
        "name": "stylish",
        "output": "console"
      },
      {
        "name": "checkstyle",
        "output": "file",
        "path": "./target/checkstyle-result.xml"
      }
    ]
  }
}
