{
  "name": "cap-fe-ts-sample-node",
  "version": "1.0.0",
  "description": "Sample application for CAP (node) Fiori Elements TypeScript",
  "repository": "https://github.com/heimwege/cap-node-fe-ts-sample",
  "engines": {
    "node": "^20.11.0"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-types": "0.16.0",
    "@cap-js/sqlite": "2.1.3",
    "@sap/cds-dk": "9.7.2",
    "@sap/eslint-plugin-cds": "4.1.2",
    "cds-plugin-ui5": "0.16.3",
    "eslint": "9.39.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "ts-node": "10.9.2"
  },
  "scripts": {
    "start": "cds watch --open com.sap.cap.fe.ts.sample/localService/index.html#Samples-display --livereload false",
    "build:cds": "cds build && npm --prefix app/samples run odata:types:generate",
    "ui:mockserver": "npm --prefix app/samples run ui:mockserver",
    "ui:cap": "npm --prefix app/samples run ui:cap",
    "ui:mockserver:proxy": "npm --prefix app/samples run ui:mockserver:proxy",
    "ui:mockserver:proxy:rta": "npm --prefix app/samples run ui:mockserver:proxy:rta",
    "ui:test": "npm --prefix app/samples run ui:test",
    "e2e:test": "npm --prefix app/samples run e2e:test"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/samples"
  ],
  "cds": {
    "cds-plugin-ui5": {
      "modules": {
        "samples": {
          "configFile": "cap-with-ui5.yaml"
        }
      }
    }
  }
}
